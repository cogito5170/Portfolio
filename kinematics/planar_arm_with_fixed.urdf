<?xml version="1.0"?>
<robot name="planar_arm_with_fixed">
  <link name="base_link"/>
  
  <link name="link1"/>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159"/>
  </joint>
  
  <link name="link2_fixed"/>
  <joint name="fixed_middle" type="fixed">
    <parent link="link1"/>
    <child link="link2_fixed"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
  </joint>

  <link name="link2"/>
  <joint name="joint2" type="revolute">
    <parent link="link2_fixed"/>
    <child link="link2"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159"/>
  </joint>
  
  <link name="link3"/>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="1.0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.0"/>
  </joint>
  
  <link name="end_effector"/>
  <joint name="tip" type="fixed">
    <parent link="link3"/>
    <child link="end_effector"/>
    <origin xyz="1.0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
